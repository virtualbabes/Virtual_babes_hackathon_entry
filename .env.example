# ==============================================================================
# Server Configuration
# ==============================================================================
# Standard PORT variable used by Render and Docker
PORT=8082

# Default network for stats lookup and onboarding (VOI or ALGO)
DEFAULT_NETWORK=VOI

# Local directory for persistent JSON caches and audit logs (Render Volume path)
DATA_DIR=./data

# Comma-separated list of allowed origins for CORS and WebSocket handshake.
# Include your Carrd production URL and localhost for testing.
ALLOWED_ORIGINS=https://yoursite.com,http://localhost:8082

# ==============================================================================
# Blockchain Nodes (Indexer & RPC) — REFERENCE ONLY, NOT READ AT RUNTIME
# These entries document the public endpoints the game expects to be configured.
# The server loads its network registry from `networks.json`, and the sanctioned
# way to set or repair a network's indexer/node base(s) is the ADMIN PANEL:
#   Admin ▸ Add / Update Network  →  POST /api/admin/network/add
# (an upsert by network_name which persists the whole registry to networks.json).
# The ONLY env vars actually read for chain access are the optional node API
# tokens ALGOD_TOKEN_VOI / ALGOD_TOKEN_ALGO and the optional IPFS_API_KEY, threaded
# into the loaded configs at boot.
#
# SECRETS ARE ENV-ONLY AND ARE NEVER PERSISTED. networks.json is GIT-TRACKED, so the
# server redacts every secret before writing it (and before serving the registry to
# clients). If a secret was configured, the boot log states that it was withheld.
# ==============================================================================
# Algorand Mainnet API (Required for Cross-chain metadata lookups)
ALGOD_URL_ALGO=https://mainnet-api.algonode.cloud
INDEXER_URL_ALGO=https://mainnet-idx.algonode.cloud
# Optional: API token for authenticated Algorand nodes
# ALGOD_TOKEN_ALGO=

# Voi Mainnet API (Primary network for the Arena)
ALGOD_URL_VOI=https://mainnet-api.voi.nodely.dev
# REFERENCE ONLY (see the header above): the server reads indexer_urls from
# networks.json. Voi splits its chain data across TWO hosts and neither serves
# the other's paths, so BOTH are registered for the network:
#   ARC-200 API + NFT indexer : https://voi-mainnet-mimirapi.nftnavigator.xyz
#   standard indexer (/v2/*)  : https://mainnet-idx.voi.nodely.dev
INDEXER_URL_VOI=https://mainnet-idx.voi.nodely.dev
# Optional: API token for authenticated Voi nodes
# ALGOD_TOKEN_VOI=

# Optional: Bearer credential for an authenticated IPFS gateway (card metadata fetches).
# Applied at boot to every network that has no key of its own. It is NEVER written to
# networks.json — the registry file is git-tracked and is redacted before every write.
# IPFS_API_KEY=

# Ethereum (ERC-721/1155 metadata discovery)
ETH_INDEXER_URL=https://api.etherscan.io
ETH_NODE_URL=https://eth.llamarpc.com

# Solana (Metaplex DAS metadata discovery)
SOLANA_INDEXER_URL=https://api.mainnet-beta.solana.com
SOLANA_NODE_URL=https://api.mainnet-beta.solana.com

# Polygon (ERC-721/1155 metadata discovery)
POLYGON_INDEXER_URL=https://api.polygonscan.com
POLYGON_NODE_URL=https://polygon.llamarpc.com

# Flow (NFT metadata discovery)
FLOW_INDEXER_URL=https://rest-mainnet.onflow.org
FLOW_NODE_URL=https://access-mainnet-beta.onflow.org

# WAX (NFT metadata discovery)
WAX_INDEXER_URL=https://wax.api.atomicassets.io
WAX_NODE_URL=https://wax.greymass.com

# Bitcoin Ordinals
BITCOIN_NODE_URL=https://ordinals.com

# ==============================================================================
# Game Economy & Assets
# ==============================================================================
# The official address holding the $VBV tokens for the faucet.
VAULT_ADDRESS=PLACEHOLDER_VAULT_ADDRESS_HERE
# The 24/25-word mnemonic for the VAULT_ADDRESS (Keep this extremely secure!)
FAUCET_MNEMONIC="word1 word2 word3 ... word25"

# NOT READ by any code (kept for reference; no handler resolves a collection id from env)
# Corrected 2026-09-17: 7900471 is ABSENT from Voi's NFT indexer
# (/nft-indexer/v1/collections?contractId=7900471 -> total-count 0). The live Voi
# collection is 8384545 = "Virtual Babes Voi Season 1".
COLLECTION_ID=8384545

# Primary Reward Asset ID ($VBV ARC-200 Contract) — ENV-OWNED AND READ-ONLY.
# The panel can READ this (GET /api/admin/networks) and can never write it: it is the asset the
# vault pays, the asset the faucet status reports and the asset every on-chain verification
# resolves against. POST /api/reward/update-asset now REFUSES with a stated reason.
REWARD_ASSET_ID=40227315
VBV_ASSET_ID=40227315
# NOT READ by any code: the faucet capacity is the hard-coded default in newLobby(). Kept for reference.
MAX_FAUCET_CAPACITY=10000

# The minimum native VOI balance required before an admin alert is triggered (e.g., 100.0)
# NOT READ by any code (kept for reference; gas alerts use their own thresholds)
VOI_GAS_THRESHOLD=100.0

# Algorand-side payment token for bridge buy-ins (e.g., $AVoi)
AVOI_ASSET_ID=2320775407
# Secondary/Fallback Asset ID for win tracking and historical aggregation
# NOT READ by any code (kept for reference)
FALLBACK_REWARD_ASSET_ID=0

# Native token asset IDs (reference data — from Voi Wallet src/services/network/config.ts)
# Voi mainnet: AUSD=34426427, USDC=34426428 | Algorand mainnet: USDC=31566704, USDT=312769
# VOI_NATIVE_AUSD_ASSET_ID=34426427
# VOI_NATIVE_USDC_ASSET_ID=34426428
# ALGO_NATIVE_USDC_ASSET_ID=31566704
# ALGO_NATIVE_USDT_ASSET_ID=312769

# Base amount of reward per win, in WHOLE units (5 = 5.0 $VBV). It is converted to exact integer
# micro-VBV at boot; a fraction is honoured exactly ("5.5" = 5500000 micro). The previous parser
# used strconv.ParseUint and silently produced 0 for the documented "5.0" spelling.
BASE_REWARD=5
# Optional: the base reward in exact micro-VBV. Takes precedence over BASE_REWARD when set.
# BASE_REWARD_MICRO=5000000

# Minimum reputation required to trigger the 10% loyalty bonus payout
# NOT READ by any code (kept for reference; the threshold is not read from env)
MIN_REPUTATION_FOR_REWARD=500

# ==============================================================================
# Administrative Security
# ==============================================================================
# Admin access is WALLET-SIGNATURE ONLY. ADMIN_WALLETS lists the wallets permitted to sign a
# server-issued nonce and present X-Admin-Wallet / X-Admin-Nonce / X-Admin-Signature.
# There is NO shared-secret admin key: the former ADMIN_KEY entry was read by no Go code and
# has been removed (documenting it as a working fallback was a false statement).
ADMIN_WALLETS=ADMIN_VOI_WALLET_1,ADMIN_VOI_WALLET_2

# ==============================================================================
# Frontend / Client Configuration
# ==============================================================================
# WalletConnect Project ID (Obtain from https://cloud.walletconnect.com)
WC_PROJECT_ID=YOUR_WALLETCONNECT_PROJECT_ID_HERE

# Voi Network Chain ID
VOI_CHAIN_ID=algorand:r20fSQI8gWe_kFZziNonSPCXLwcQmH_n
ALGO_CHAIN_ID=algorand:wGHE2Pwdvd7S12BL5FaOP20EGYesN73k
ETH_CHAIN_ID=eip155:1

# ==============================================================================
# Development & Testing
# ==============================================================================
ARENA_STRESS_TEST=false

# Envoi naming-service API base (Voi human-readable addresses, like ENS).
# Optional: defaults to https://api.envoi.sh when unset.
ENVOI_API_URL=https://api.envoi.sh
